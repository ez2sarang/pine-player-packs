                  "then": [{ "op": "click", "selector": { "textRegex": "취소|아니오|아니요" } }]
                },
                {
                  "op": "ifPresent",
                  "selector": { "id": "com.iloen.melon:id/close_btn" },
                  "then": [{ "op": "click", "selector": { "id": "com.iloen.melon:id/close_btn" } }]
