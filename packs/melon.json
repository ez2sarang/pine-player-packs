{
  "format": 1,
  "id": "melon",
  "version": 4,
  "nameKo": "멜론",
  "nameEn": "Melon",
  "aliases": ["멜론", "멜론에서", "melon"],
  "packageName": "com.iloen.melon",
  "tier": "AD_UNLOCK",
  "unlockHours": 24,
  "note": "2026-09-05 실기기(6.25.2.1, 로그아웃 상태) 조사값. 세션 비트 실측: STOP/PAUSE/PLAY/SKIP_PREV/SKIP_NEXT/SEEK_TO/PLAY_PAUSE/PLAY_FROM_SEARCH. 커스텀 액션은 Shuffle Off/Repeat Off 로 상태와 무관하게 고정이라 셔플·반복은 넣지 않았다. playlistRemove 는 '현재 재생목록(큐)에서 빼기'다. 내 플레이리스트 편집은 로그인 후 조사. 2차 실기기 검증(2026-09-06): 로그아웃이면 '전곡 듣기는 로그인 후…' 배너가 미니 플레이어 줄을 덮어 접근성 트리에 content 와 '로그인 팝업 닫기' 두 노드만 남는다. 그래서 모든 레시피가 앵커(재생목록으로 이동)를 기다리기 전에 배너를 닫고, 곡이 바뀌면 다시 뜨므로 앵커를 잡은 뒤 한 번 더 닫는다. 3차 실기기 검증(2026-09-06): 좋아요는 배너 닫기→앵커→더보기→btn_like 까지 눌렸는데 멜론이 ‘로그인이 필요한 서비스입니다. 로그인하시겠습니까?’ 다이얼로그를 띄워 다음 close_btn 단계가 실패했다. 이제 누른 뒤에 그 다이얼로그를 보고, 있으면 취소·아니오·아니요 중 하나를 누르고 로그인하라고 말하며 끝낸다. 미검증: 좋아요된 상태의 desc 문구, 재생목록 행의 체크박스(행이 컴포즈 노드 하나라 자식이 없어 좌표 6%로 누른다), 삭제 확인창 유무, 취소 버튼의 정확한 글자.",
  "capabilities": [
    "TRANSPORT",
    "SEEK",
    "NOW_PLAYING",
    "VOLUME",
    "OPEN_APP",
    "SEARCH_PLAY",
    "LIKE_UI",
    "PLAYLIST_REMOVE_UI"
  ],
  "customActions": {},
  "automation": {
    "type": "recipe",
    "recipes": {
      "searchPlay": [
        { "op": "searchIntent", "query": "{query}" },
        { "op": "waitFor", "selector": { "text": "재생" }, "timeoutMs": 8000 },
        { "op": "click", "selector": { "text": "재생" } },
        { "op": "done", "message": "멜론에서 ‘{query}’를 틀었어요" }
      ],
      "like": [
        { "op": "launch" },
        {
          "op": "ifPresent",
          "selector": { "desc": "로그인 팝업 닫기" },
          "then": [{ "op": "click", "selector": { "desc": "로그인 팝업 닫기" } }]
        },
        {
          "op": "waitFor",
          "selector": { "desc": "재생목록으로 이동" },
          "timeoutMs": 8000,
          "failMessage": "멜론 화면에서 재생목록 버튼을 찾지 못했어요. 로그인이 필요할 수 있어요"
        },
        {
          "op": "ifPresent",
          "selector": { "desc": "로그인 팝업 닫기" },
          "then": [{ "op": "click", "selector": { "desc": "로그인 팝업 닫기" } }]
        },
        { "op": "click", "selector": { "desc": "더보기" } },
        { "op": "waitFor", "selector": { "id": "com.iloen.melon:id/btn_like" }, "timeoutMs": 6000 },
        {
          "op": "ifPresent",
          "selector": { "id": "com.iloen.melon:id/btn_like", "descContains": "좋아요 선택하기" },
          "then": [
            { "op": "click", "selector": { "id": "com.iloen.melon:id/btn_like" } },
            {
              "op": "ifPresent",
              "selector": { "textContains": "로그인이 필요한" },
              "then": [
                {
                  "op": "ifPresent",
                  "selector": { "textRegex": "취소|아니오|아니요" },
                  "then": [{ "op": "click", "selector": { "textRegex": "취소|아니오|아니요" } }]
                },
                { "op": "fail", "message": "멜론에 로그인해야 좋아요를 누를 수 있어요" }
              ]
            },
            { "op": "click", "selector": { "id": "com.iloen.melon:id/close_btn" } },
            { "op": "done", "message": "멜론에서 좋아요를 눌렀어요" }
          ],
          "else": [
            { "op": "click", "selector": { "id": "com.iloen.melon:id/close_btn" } },
            { "op": "done", "message": "이미 좋아요된 곡이에요" }
          ]
        }
      ],
      "unlike": [
        { "op": "launch" },
        {
          "op": "ifPresent",
          "selector": { "desc": "로그인 팝업 닫기" },
          "then": [{ "op": "click", "selector": { "desc": "로그인 팝업 닫기" } }]
        },
        {
          "op": "waitFor",
          "selector": { "desc": "재생목록으로 이동" },
          "timeoutMs": 8000,
          "failMessage": "멜론 화면에서 재생목록 버튼을 찾지 못했어요. 로그인이 필요할 수 있어요"
        },
        {
          "op": "ifPresent",
          "selector": { "desc": "로그인 팝업 닫기" },
          "then": [{ "op": "click", "selector": { "desc": "로그인 팝업 닫기" } }]
        },
        { "op": "click", "selector": { "desc": "더보기" } },
        { "op": "waitFor", "selector": { "id": "com.iloen.melon:id/btn_like" }, "timeoutMs": 6000 },
        {
          "op": "ifPresent",
          "selector": { "id": "com.iloen.melon:id/btn_like", "descContains": "좋아요 선택하기" },
          "then": [
            { "op": "click", "selector": { "id": "com.iloen.melon:id/close_btn" } },
            { "op": "done", "message": "이 곡은 좋아요가 안 눌려 있어요" }
          ],
          "else": [
            { "op": "click", "selector": { "id": "com.iloen.melon:id/btn_like" } },
            {
              "op": "ifPresent",
              "selector": { "textContains": "로그인이 필요한" },
              "then": [
                {
                  "op": "ifPresent",
                  "selector": { "textRegex": "취소|아니오|아니요" },
                  "then": [{ "op": "click", "selector": { "textRegex": "취소|아니오|아니요" } }]
                },
                { "op": "fail", "message": "멜론에 로그인해야 좋아요를 누를 수 있어요" }
              ]
            },
            { "op": "click", "selector": { "id": "com.iloen.melon:id/close_btn" } },
            { "op": "done", "message": "멜론에서 좋아요를 껐어요" }
          ]
        }
      ],
      "playlistRemove": [
        { "op": "launch" },
        {
          "op": "ifPresent",
          "selector": { "desc": "로그인 팝업 닫기" },
          "then": [{ "op": "click", "selector": { "desc": "로그인 팝업 닫기" } }]
        },
        {
          "op": "waitFor",
          "selector": { "desc": "재생목록으로 이동" },
          "timeoutMs": 8000,
          "failMessage": "멜론 화면에서 재생목록 버튼을 찾지 못했어요. 로그인이 필요할 수 있어요"
        },
        { "op": "pauseIfPlaying" },
        {
          "op": "ifPresent",
          "selector": { "desc": "로그인 팝업 닫기" },
          "then": [{ "op": "click", "selector": { "desc": "로그인 팝업 닫기" } }]
        },
        { "op": "click", "selector": { "desc": "재생목록으로 이동" } },
        {
          "op": "waitFor",
          "selector": { "descContains": "{title}, 아티스트: {artist}" },
          "timeoutMs": 8000
        },
        {
          "op": "clickAt",
          "selector": { "descContains": "{title}, 아티스트: {artist}" },
          "xPercent": 6,
          "yPercent": 50
        },
        {
          "op": "waitFor",
          "selector": { "id": "com.iloen.melon:id/btn_toolbar", "text": "삭제" },
          "timeoutMs": 6000
        },
        { "op": "click", "selector": { "id": "com.iloen.melon:id/btn_toolbar", "text": "삭제" } },
        {
          "op": "ifPresent",
          "selector": { "textContains": "로그인이 필요한" },
          "then": [
            {
              "op": "ifPresent",
              "selector": { "textRegex": "취소|아니오|아니요" },
              "then": [{ "op": "click", "selector": { "textRegex": "취소|아니오|아니요" } }]
            },
            { "op": "fail", "message": "멜론에 로그인해야 재생목록에서 뺄 수 있어요" }
          ]
        },
        { "op": "confirm" },
        { "op": "back", "times": 1 },
        { "op": "done", "message": "재생목록에서 ‘{title}’을(를) 뺐어요" }
      ]
    }
  }
}
